{
  "rewrites": [
    {
      "source": "/my-analytics/script.js",
      "destination": "https://va.vercel-scripts.com/v1/script.js"
    },
    {
      "source": "/my-analytics/view",
      "destination": "https://va.vercel-scripts.com/v1/view"
    },
    {
      "source": "/my-analytics/:match*",
      "destination": "https://va.vercel-scripts.com/v1/:match*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type",  "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}